{
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/scripts/pre-tool-use.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "lint-checker": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/scripts/post-tool-use.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
