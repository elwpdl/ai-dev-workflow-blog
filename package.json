{
  "name": "ai-dev-workflow-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "playwright test",
    "test:hooks": "node --test scripts/agent-hooks.test.mjs",
    "test:agent-config": "node --test scripts/agent-config.test.mjs",
    "test:monitoring": "node --test scripts/monitoring-sanitizer.test.mjs && node scripts/verify-monitoring.mjs",
    "test:container": "playwright test --config playwright.container.config.ts",
    "verify": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.13",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "typescript": "^6.0.3"
  }
}
