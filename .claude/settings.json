{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "command": "bash .claude/hooks/pre-tool-use.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "command": "bash .claude/hooks/post-tool-use.sh"
      }
    ]
  }
}
